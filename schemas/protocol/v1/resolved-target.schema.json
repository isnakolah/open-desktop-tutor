{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-desktop-tutor.org/schemas/protocol/v1/resolved-target.schema.json",
  "title": "Fresh semantic UI target receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["semantic_id", "snapshot_id", "window_id", "bounds", "confidence", "evidence", "valid_until"],
  "properties": {
    "semantic_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "opaque_element_id": {"type": ["string", "null"]},
    "window_id": {"type": "integer", "minimum": 1},
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "valid_until": {"enum": ["next_window_mutation", "deadline"]},
    "deadline": {"type": ["string", "null"], "format": "date-time"}
  }
}
