{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-desktop-tutor.org/schemas/protocol/v1/envelope.schema.json",
  "title": "Tutor Host Request Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "operation", "session_id", "payload"],
  "properties": {
    "protocol_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "operation": {"enum": ["session_start", "observe", "retrieve", "point", "propose_action", "verify", "record_learning"]},
    "session_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "payload": {"type": "object"}
  }
}
